{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Atletis",
  "theme": "almond",
  "logo": {
    "light": "https://media.brand.dev/a5f7f5cb-0ca5-46c5-acc4-7f287a2d7841.svg",
